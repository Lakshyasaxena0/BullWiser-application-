{
  "name": "bullwiser-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "BullWiser for Windows 7/8/10/11 (Electron 22 shell around the hosted web app)",
  "author": "AstroWizard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --ia32 --x64"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.bullwiser.app",
    "productName": "BullWiser",
    "files": ["main.js", "offline.html", "app-config.json", "build/icon.png"],
    "extraMetadata": { "main": "main.js" },
    "win": { "target": [{ "target": "nsis", "arch": ["ia32", "x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "artifactName": "BullWiser-Setup-${version}-${arch}.${ext}" }
  }
}
